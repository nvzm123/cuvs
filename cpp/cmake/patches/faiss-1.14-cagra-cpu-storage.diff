+// A CUDA device alias for mapped host memory can have a different address
+// from the one the CPU can dereference.
+const float* host_address(const float* ptr) {
+    if (!ptr) {
+        return nullptr;
+    }
+    cudaPointerAttributes attributes{};
+    const auto status = cudaPointerGetAttributes(&attributes, ptr);
+    if (status == cudaErrorInvalidValue) {
+        // Older CUDA runtimes report this for ordinary host allocations.
+        cudaGetLastError();
+        return ptr;
+    }
+    CUDA_VERIFY(status);
+    if (attributes.type == cudaMemoryTypeUnregistered) {
+        return ptr;
+    }
+    return static_cast<const float*>(attributes.hostPointer);
+}
+
+// Workers first-touch disjoint blocks of the new CPU allocation.
+void copy_host_vectors(uint8_t* output, const float* input, size_t bytes) {
+    constexpr size_t block_size = 1024 * 1024;
+    const idx_t blocks = 1 + (bytes - 1) / block_size;
+    const int threads = std::min<idx_t>(blocks, omp_get_max_threads());
+    const auto* src = reinterpret_cast<const uint8_t*>(input);
+#pragma omp parallel for schedule(static) if (threads > 1) num_threads(threads)
+    for (idx_t block = 0; block < blocks; ++block) {
+        const size_t offset = block * block_size;
+        std::memcpy(
+                output + offset,
+                src + offset,
+                std::min(block_size, bytes - offset));
+    }
+}
+
+std::unique_ptr<IndexFlat> copy_float_storage(
+        CuvsCagra<float>& source,
+        const IndexHNSWCagra& destination,
+        idx_t count,
+        int dim,
+        MetricType metric,
+        const raft::device_resources& handle,
+        CagraCpuStorage mode) {
+    std::unique_ptr<IndexFlat> flat;
+    if (metric == METRIC_L2) {
+        flat = std::make_unique<IndexFlatL2>(dim);
+    } else {
+        FAISS_THROW_IF_NOT(metric == METRIC_INNER_PRODUCT);
+        flat = std::make_unique<IndexFlatIP>(dim);
+    }
+    const size_t bytes = mul_no_overflow(count, flat->code_size, "CAGRA codes");
+    if (bytes != 0) {
+        const auto* input = source.get_training_dataset();
+        FAISS_THROW_IF_NOT(input);
+        if (mode == CagraCpuStorage::Overwrite) {
+            flat->codes = OverwriteCodeBuffer::allocate(bytes);
+        } else {
+            flat->codes.resize(bytes);
+        }
+        if (const auto* host = host_address(input)) {
+            handle.sync_stream();
+            copy_host_vectors(flat->codes.data(), host, bytes);
+
+            // An in-place round trip can replace the owner of the GPU index's
+            // borrowed host data. Keep those original pages alive for reuse.
+            auto* old = dynamic_cast<IndexFlatCodes*>(destination.storage);
+            if (destination.own_fields && old &&
+                (old->codes.is_owned || old->codes.owner)) {
+                const auto address = reinterpret_cast<uintptr_t>(host);
+                const auto begin =
+                        reinterpret_cast<uintptr_t>(old->codes.data());
+                if (address >= begin && address - begin < old->codes.size()) {
+                    source.retain_training_data(
+                            std::make_shared<MaybeOwnedVector<uint8_t>>(
+                                    std::move(old->codes)));
+                }
+            }
+        } else {
+            raft::copy(
+                    flat->get_xb(),
+                    input,
+                    bytes / sizeof(float),
+                    handle.get_stream());
+            handle.sync_stream();
+        }
+    }
+    flat->ntotal = count;
+    return flat;
+}
