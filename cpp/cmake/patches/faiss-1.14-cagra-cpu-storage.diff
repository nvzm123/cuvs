+TEST(TestGpuIndexCagra, Float32_ExportVectorStorage) {
+    // A little over one copy block, including a partial final block.
+    constexpr int rows = 512;
+    constexpr int dim = 513;
+    const auto values = faiss::gpu::randVecs(rows, dim);
+    faiss::gpu::StandardGpuResources res;
+    faiss::gpu::GpuIndexCagraConfig config;
+    config.build_algo = faiss::gpu::graph_build_algo::NN_DESCENT;
+    config.graph_degree = 16;
+    config.intermediate_graph_degree = 32;
+    for (bool baseLevelOnly : {true, false}) {
+        SCOPED_TRACE(baseLevelOnly);
+        faiss::IndexHNSWCagra standard, overwrite;
+        standard.base_level_only = overwrite.base_level_only = baseLevelOnly;
+        {
+            auto input = values;
+            faiss::gpu::GpuIndexCagra gpu(&res, dim, faiss::METRIC_L2, config);
+            gpu.train(rows, input.data());
+            gpu.copyTo(&standard);
+            gpu.copyTo(&overwrite, faiss::gpu::CagraCpuStorage::Overwrite);
+        }
+        EXPECT_TRUE(dynamic_cast<faiss::IndexFlat&>(*standard.storage)
+                            .codes.is_owned);
+        EXPECT_FALSE(dynamic_cast<faiss::IndexFlat&>(*overwrite.storage)
+                             .codes.is_owned);
+        for (auto* index : {&standard, &overwrite}) {
+            ASSERT_EQ(index->ntotal, rows);
+            std::unique_ptr<faiss::Index> clone(
+                    faiss::clone_index(index->storage));
+            dynamic_cast<faiss::IndexFlat&>(*clone).get_xb()[0] += 1.0f;
+            std::vector<float> exported(values.size());
+            index->reconstruct_n(0, rows, exported.data());
+            EXPECT_EQ(exported, values);
+            if (!baseLevelOnly) {
+                index->add(1, values.data());
+                ASSERT_EQ(index->ntotal, rows + 1);
+                std::vector<float> tail(dim);
+                index->reconstruct(rows, tail.data());
+                EXPECT_TRUE(std::equal(tail.begin(), tail.end(), values.begin()));
+            }
+        }
+        if (baseLevelOnly) {
+            // The GPU index borrows its input. Replacing the owning CPU index
+            // must keep the original pages alive for another export.
+            std::weak_ptr<faiss::MaybeOwnedVectorOwner> inputOwner =
+                    dynamic_cast<faiss::IndexFlat&>(*overwrite.storage)
+                            .codes.owner;
+            faiss::gpu::GpuIndexCagra borrowed(&res, dim, faiss::METRIC_L2);
+            borrowed.copyFrom(&overwrite);
+            borrowed.copyTo(&overwrite, faiss::gpu::CagraCpuStorage::Overwrite);
+            EXPECT_FALSE(inputOwner.expired());
+            faiss::IndexHNSWCagra again;
+            again.base_level_only = true;
+            borrowed.copyTo(&again, faiss::gpu::CagraCpuStorage::Overwrite);
+            std::vector<float> exported(values.size());
+            borrowed.reset();
+            EXPECT_TRUE(inputOwner.expired());
+            again.reconstruct_n(0, rows, exported.data());
+            EXPECT_EQ(exported, values);
+
+            auto& donor = dynamic_cast<faiss::IndexFlat&>(*again.storage);
+            faiss::IndexFlatL2 recipient(dim);
+            recipient.merge_from(donor);
+            EXPECT_EQ(donor.ntotal, 0);
+            EXPECT_EQ(donor.codes.size(), 0);
+            EXPECT_EQ(recipient.ntotal, rows);
+            EXPECT_TRUE(std::equal(
+                    values.begin(), values.end(), recipient.get_xb()));
+            overwrite.reset();
+            EXPECT_EQ(overwrite.ntotal, 0);
+        }
+    }
+}
